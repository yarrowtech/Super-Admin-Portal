# Copy this file to .env and fill in real values before starting the server.
# Never commit the actual .env file.

# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=

# Comma-separated list of allowed browser origins for CORS in production.
# (localhost origins are added automatically in development, no need to list them here)
CORS_ORIGIN=https://your-frontend-domain.com

# ── Auth ──────────────────────────────────────────────────────────────────
# Required in production; a dev-only default is used automatically otherwise.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Optional: Redis-backed cache ─────────────────────────────────────────
# If unset, the server falls back to an in-memory cache automatically.
# Only needed when running more than one backend instance behind a load balancer.
CACHE_ENABLED=true
CACHE_VERSION=v1
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=750
REDIS_LOCK_TTL_MS=5000
REDIS_LOCK_WAIT_MS=750
LOG_CACHE_EVENTS=false
CACHE_TTL_AUTH_PROFILE_SECONDS=120
CACHE_TTL_PERMISSIONS_SECONDS=900
CACHE_TTL_DASHBOARD_SECONDS=60
CACHE_TTL_ANALYTICS_SECONDS=300
CACHE_TTL_LIST_SECONDS=180
CACHE_TTL_REFERENCE_SECONDS=1800
CACHE_TTL_DEFAULT_SECONDS=90

# ── Optional: file storage (Cloudinary) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional: outsourcing / cross-portal SSO ─────────────────────────────
OUTSOURCING_SHARED_SECRET=
OUTSOURCING_PORTAL_URL=
EEC_PORTAL_URL=
EHC_PORTAL_URL=
RMS_PORTAL_URL=
ESPORTSM_PORTAL_URL=
SMARTFARMING_PORTAL_URL=
EFNBMMS_ADMIN_MANAGEMENT_API_URL=
EFNBMMS_API_TOKEN=
EDIFYEIGHT_API_URL=http://127.0.0.1:5001
EDIFYEIGHT_TEACHER_API_URL=http://127.0.0.1:5001/api/internal/teachers
EDIFYEIGHT_STUDY_MATERIAL_API_URL=http://127.0.0.1:5001/api/internal/study-materials
EDIFYEIGHT_API_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────
ENABLE_SELF_REGISTRATION=false
LOG_LEVEL=info

# Optional: Render free-instance warm ping while the backend process is running.
# Set URL to your backend base URL; /health is appended automatically.
RENDER_KEEP_ALIVE_ENABLED=false
RENDER_KEEP_ALIVE_URL=https://your-backend-service.onrender.com
RENDER_KEEP_ALIVE_INTERVAL_MINUTES=10
