# Central Policy API backend — copy values into your deployment secret manager.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Comma-separated HTTPS frontends allowed to call authenticated APIs.
CORS_ORIGIN=https://super-admin.example.com,https://project.example.com

# Generate distinct secrets (minimum 32 characters). Never commit real values.
JWT_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Recommended for multi-instance production deployments.
CACHE_ENABLED=true
REDIS_URL=redis://<host>:6379

# Optional: per-API-client rate limiting for the public EFNBMMS consumer policy
# API (POST /auth/token + GET /policies...). Defaults: 100 requests/minute/client.
POLICY_CLIENT_RATE_LIMIT_WINDOW_MS=60000
POLICY_CLIENT_RATE_LIMIT_MAX=100

# ── External marketing platform (CEO > Marketing Analytics) ──────────────────
# Marketing work happens in a separate platform; the CEO portal only reads from it.
# These stay server-side: the browser calls /api/ceo/marketing-analytics, never the
# platform directly, so none of these values is ever sent to the frontend.
# With BASE_URL or the credential unset, the module reports "not configured" and the
# dashboard shows its setup state instead of inventing data.
MARKETING_PLATFORM_BASE_URL=https://<marketing-platform-host>/api/v1
# Supply exactly one credential. A token is sent as `Authorization: Bearer`,
# an API key as `X-API-Key`.
MARKETING_PLATFORM_TOKEN=
MARKETING_PLATFORM_API_KEY=
# Optional tuning. Endpoint paths are overridable so a vendor's own naming can be used
# without a code change.
MARKETING_PLATFORM_TIMEOUT_MS=12000
MARKETING_PLATFORM_PAGE_SIZE=500
MARKETING_PLATFORM_MAX_PAGES=40
MARKETING_PLATFORM_LEADS_PATH=leads
MARKETING_PLATFORM_CAMPAIGNS_PATH=campaigns
# Note: there is no projects path. The project list is read from our own project
# database, which is the master source for projects; the platform supplies marketing
# activity only. The selector therefore works even with no platform configured.
# How long an aggregated pull is cached, in seconds.
MARKETING_ANALYTICS_CACHE_TTL=120

# ── Overdue invoice escalation (Finance) ─────────────────────────────────────
# A nightly job that tells the finance head and the project's manager about invoices
# past due. Idempotent: each invoice carries an `escalatedAt` watermark, so it is
# chased on crossing the threshold and then only once per re-escalation window —
# not every night until it is paid. Disputed invoices are skipped.
FINANCE_OVERDUE_ESCALATION_ENABLED=true
# Standard cron, 5 fields. Default 07:30 daily.
FINANCE_OVERDUE_ESCALATION_CRON=30 7 * * *
FINANCE_OVERDUE_ESCALATION_TZ=Asia/Kolkata
# Days past the due date before an invoice is escalated.
FINANCE_OVERDUE_ESCALATION_DAYS=7
# Days before a still-unpaid invoice is chased again.
FINANCE_OVERDUE_REESCALATE_DAYS=14
# Most invoices handled in one run, so a large backlog cannot flood recipients.
FINANCE_OVERDUE_ESCALATION_LIMIT=200

# Optional existing project/provider adapters. Set actual documented resource URLs,
# not guessed hosts. Retain EFMBMMS_* legacy aliases only where already deployed.
EFNBMMS_ADMIN_MANAGEMENT_API_URL=
EFNBMMS_API_TOKEN=
EDIFYEIGHT_API_URL=
EDIFYEIGHT_TEACHER_API_URL=
EDIFYEIGHT_STUDY_MATERIAL_API_URL=
EDIFYEIGHT_API_TOKEN=
EEC_PORTAL_URL=
EHC_PORTAL_URL=
RMS_PORTAL_URL=
OUTSOURCING_PORTAL_URL=
OUTSOURCING_SHARED_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Existing YarrowTech SRS configuration. Supplying credentials does not verify
# the provider protocol or enable blocked SRS business operations.
SRS_API_BASE_URL=https://api.yarrowtech.in
SRS_API_KEY=
SRS_CLIENT_ID=
SRS_SIGNING_SECRET=
SRS_WEBHOOK_SECRET=
# Preserve deployment settings; no automatic production sync is enabled here.
# Existing code defaults WORKSPACE_SYNC_AUTOMATIC to true if omitted.
WORKSPACE_SYNC_AUTOMATIC=false
WORKSPACE_SYNC_POLL_SECONDS=300
