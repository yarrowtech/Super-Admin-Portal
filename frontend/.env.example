# Central Super Admin Portal frontend. This value is safe to expose to the browser.
VITE_API_URL=https://api.example.com

# Optional separate central Policy API. Use this for project applications whose
# existing VITE_API_URL points to their own operational-data API.
# If omitted, policy calls use VITE_API_URL.
VITE_POLICY_API_URL=https://super-admin-api.example.com

# Leave empty in the central portal because users select a project dynamically.
# A standalone project application sets its own canonical projectId here.
VITE_POLICY_PROJECT_ID=

# Do not add JWT secrets, database URLs, Cloudinary secrets, or private API keys
# to VITE_ variables: Vite exposes them to the browser.
