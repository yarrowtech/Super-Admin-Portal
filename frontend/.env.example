# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL of the backend API
VITE_API_URL=http://localhost:5000

# Optional: only needed if the outsourcing portal is hosted separately from VITE_API_URL
VITE_OUTSOURCING_PORTAL_URL=

# Optional: proxy base for the EFNBMMS admin-management integration
VITE_EFNBMMS_ADMIN_MANAGEMENT_PROXY_BASE=

# Optional: base URL override for Super Admin-specific API calls
VITE_SUPER_ADMIN_API_BASE=

# Optional: frontend log verbosity (debug | info | warn | error)
VITE_LOG_LEVEL=info
